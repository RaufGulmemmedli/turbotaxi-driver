# TurboTaxi public configuration (Expo public env vars are bundled into the app).
# Copy to .env and adjust per environment. Do NOT put secrets in EXPO_PUBLIC_* vars.

# Backend API base URL. Leave empty until the backend is connected.
EXPO_PUBLIC_API_URL=

# Public contact / marketing
EXPO_PUBLIC_WEBSITE=https://turbotaxi.app
EXPO_PUBLIC_SUPPORT_EMAIL=support@turbotaxi.app
EXPO_PUBLIC_SALES_EMAIL=sales@turbotaxi.app

# Set to "false" to switch the public sign-up flow off and show "Request Access" instead.
EXPO_PUBLIC_REGISTRATION_ENABLED=true

# Demo / App Review account. Used to power the in-app "Try Demo" button.
EXPO_PUBLIC_DEMO_ENABLED=true
EXPO_PUBLIC_DEMO_EMAIL=demo@turbotaxi.app
EXPO_PUBLIC_DEMO_PASSWORD=demo1234
