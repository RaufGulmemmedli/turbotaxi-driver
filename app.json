{
  "expo": {
    "name": "TaxiDriver",
    "slug": "TaxiDriver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/driver-icon.png",
    "scheme": "taxidriver",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/driver-icon.png",
      "bundleIdentifier": "com.turbotaxi.driver",
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "",
      "website": "https://turbotaxi.app",
      "supportEmail": "support@turbotaxi.app",
      "salesEmail": "sales@turbotaxi.app",
      "registrationEnabled": "true",
      "demoEnabled": "true",
      "demoEmail": "demo@turbotaxi.app",
      "demoPassword": "demo1234",
      "router": {},
      "eas": {
        "projectId": "a935220f-ad1c-4292-b555-fa6510111277"
      }
    }
  }
}
